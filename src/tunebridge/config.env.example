# Nach ~/.config/tunebridge/config.env kopieren und ausfüllen (chmod 600).
# Leere Einträge = Funktion aus.

# Wo DB/Cache/Exporte liegen (Standard: ~/.local/share/tunebridge)
TUNEBRIDGE_DATA=
# Wohin Sicherungen gehen (Standard: <Daten>/backups) – am besten eine andere Platte
TUNEBRIDGE_BACKUP_DIR=

# Update-Quelle (Standard ist im Programm hinterlegt)
UPDATE_REPO=

# --- Genres & ähnliche Songs ----------------------------------------
LASTFM_API_KEY=

# --- Song-Erkennung (Shazam braucht keinen Key) ----------------------
# AudD: https://dashboard.audd.io  (Test-Kontingent kostenlos)
AUDD_API_TOKEN=
# ACRCloud: https://console.acrcloud.com -> Audio & Video Recognition -> Projekt
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# --- Optional: lokales LLM (OpenAI-kompatibel, z.B. llama.cpp-Server) -
# hilft beim Subgenre, wenn die Tags nur "Drum & Bass" hergeben
LLM_URL=
LLM_MODEL=

# --- Plattformen (kommt später) ---------------------------------------
SPOTIFY_CLIENT_ID=
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
# Ablageort der lokalen LLM-Modelle (Standard: <TUNEBRIDGE_DATA>/llm)
TUNEBRIDGE_MODELS_DIR=
