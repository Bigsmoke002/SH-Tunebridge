<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_mic" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center" android:background="@drawable/widget_btn"
            android:text="Erkennen" android:textColor="#FF0B0D10" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_sys" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:layout_marginStart="8dp" android:gravity="center"
            android:background="@drawable/widget_btn2" android:text="Handy-Ton" android:textColor="#FFE8EAED"
            android:textSize="15sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_last" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FF9AA0A6"
        android:textSize="12sp" android:text="Noch nichts erkannt" />
</LinearLayout>
